AWS_PROFILE=personal
AWS_REGION=eu-west-1
STACK_NAME=ai-chat-stack
NAMESPACE=ai-chat
# Optional:
# DSQL_REGION defaults to AWS_REGION
# MODEL_ID defaults to minimax.minimax-m2.1
# DSQL_ENDPOINT is intentionally omitted:
# - CDK injects it into deployed Lambda environment variables.
# - Local dev/seed resolve it dynamically from CloudFormation stack outputs.
